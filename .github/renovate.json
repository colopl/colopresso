{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "automerge": false,
  "prHourlyLimit": 0,
  "git-submodules": {
    "enabled": true
  },
  "customDatasources": {
    "valgrind": {
      "defaultRegistryUrlTemplate": "https://sourceware.org/pub/valgrind/",
      "format": "html"
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track Valgrind releases from the official download directory",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=custom\\.valgrind depName=valgrind\\s*\\nARG VALGRIND_VERSION=(?<currentValue>\\d+\\.\\d+(?:\\.\\d+)?)"
      ],
      "depNameTemplate": "valgrind",
      "datasourceTemplate": "custom.valgrind",
      "extractVersionTemplate": "^valgrind-(?<version>\\d+\\.\\d+(?:\\.\\d+)?)\\.tar\\.bz2$",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "description": "Update wasm-pack pin",
      "managerFilePatterns": [
        "/^rust-toolchain\\.toml$/"
      ],
      "matchStrings": [
        "(?:^|\\n)wasm-pack\\s*=\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "wasm-bindgen/wasm-pack",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Track GitHub-hosted runner labels set in workflow matrices; the github-actions manager only reads a job's own runs-on",
      "managerFilePatterns": [
        "/(^|/)\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?:^|\\n)[ ]{6,}(?:-[ ]+)?runs-on:[ ]*['\"]?(?<depName>ubuntu|macos|windows)-(?<currentValue>[0-9][^\\s'\"]*)['\"]?"
      ],
      "datasourceTemplate": "github-runners",
      "versioningTemplate": "docker",
      "depTypeTemplate": "github-runner"
    }
  ],
  "packageRules": [
    {
      "description": "Semver format",
      "matchManagers": [
        "git-submodules"
      ],
      "matchDepNames": [
        "third_party/emsdk",
        "third_party/Unity",
        "third_party/libpng",
        "third_party/libwebp",
        "third_party/libavif",
        "third_party/oxipng",
        "third_party/libimagequant",
        "third_party/cbindgen",
        "third_party/zlib"
      ],
      "versioning": "semver-coerced"
    },
    {
      "description": "Disable digest udates for git submodules",
      "matchManagers": [
        "git-submodules"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "enabled": false
    },
    {
      "description": "Match pnpm's default minimumReleaseAge (1440 minutes) so lockfile updates pass the supply-chain check",
      "matchDatasources": [
        "npm"
      ],
      "minimumReleaseAge": "1 day"
    },
    {
      "description": "Keep the macOS runners of release builds: binaries built on a newer macOS require that macOS because no deployment target is set",
      "matchFileNames": [
        ".github/workflows/release.yaml"
      ],
      "matchDatasources": [
        "github-runners"
      ],
      "matchPackageNames": [
        "macos"
      ],
      "enabled": false
    }
  ]
}
